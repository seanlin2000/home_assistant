+
+// Trial patch (STRATA_METAL_RELEASE_HOST_WEIGHTS): what purge_device_allocations(min_bytes) would give back, logged
+// largest first, so each allocation can be matched to a region in vmmap.
+void log_device_allocations(size_t min_bytes) {
+    Runtime& r = rt();
+    std::lock_guard<std::mutex> lk(r.mu);
+    std::vector<size_t> sizes;
+    uint64_t total = 0;
+    for (auto& [gpu, a] : r.by_gpu) {
+        if (a.host || a.purged || a.bytes < min_bytes) continue;
+        sizes.push_back(a.bytes);
+        total += a.bytes;
+    }
+    std::sort(sizes.rbegin(), sizes.rend());
+    std::fprintf(stderr, "strata metal resident: %zu device allocations of %zu MiB or more, %.1f MiB in all; largest:",
+                 sizes.size(), min_bytes >> 20, total / 1048576.0);
+    for (size_t i = 0; i < sizes.size() && i < 16; ++i) std::fprintf(stderr, " %.1f", sizes[i] / 1048576.0);
+    std::fprintf(stderr, " MiB\n");
+}
+
+// Trial patch: the same allocations as purge_device_allocations, overwritten with 0xFF (NaN in f16 and bf16) and kept,
+// so a later read by a GPU kernel or the CPU shows up as wrong output instead of going unnoticed.  Returns the bytes.
+uint64_t poison_device_allocations(size_t min_bytes) {
+    Runtime& r = rt();
+    device_synchronize();
+    std::lock_guard<std::mutex> lk(r.mu);
+    uint64_t n = 0;
+    for (auto& [gpu, a] : r.by_gpu) {
+        if (a.host || a.purged || a.bytes < min_bytes) continue;
+        std::memset(a.cpu, 0xFF, a.bytes);
+        n += a.bytes;
+    }
     return n;
 }
 
