 namespace {
+// Trial patch, off unless STRATA_METAL_RELEASE_HOST_WEIGHTS is set: in resident mode, at the first request, the host
+// code's device weight copies (allocations of STRATA_METAL_RELEASE_MIN_MIB, default 32, or more) are overwritten with
+// 0xFF ("poison", to prove nothing reads them) or given back ("release"), as streaming mode's stream_arena gives them back.
+void release_host_weights_once(bool streaming) {
+    static bool done = false;
+    if (done || streaming) return;
+    done = true;
+    const char* mode_text = std::getenv("STRATA_METAL_RELEASE_HOST_WEIGHTS");
+    if (!mode_text || !*mode_text) return;
+    const std::string mode(mode_text);
+    const char* min_mib_text = std::getenv("STRATA_METAL_RELEASE_MIN_MIB");
+    const size_t min_bytes = (size_t) (min_mib_text ? std::atoll(min_mib_text) : 32) << 20;
+    strata::gpu::log_device_allocations(min_bytes);
+    uint64_t bytes = 0;
+    if (mode == "poison") bytes = strata::gpu::poison_device_allocations(min_bytes);
+    else if (mode == "release") bytes = strata::gpu::purge_device_allocations(min_bytes);
+    else {
+        std::fprintf(stderr, "strata metal resident: STRATA_METAL_RELEASE_HOST_WEIGHTS=%s is not poison or release; nothing done\n", mode_text);
+        return;
+    }
+    std::fprintf(stderr, "strata metal resident: %s: %.2f GB of the host code's device weight copies\n", mode_text, bytes / 1e9);
+}
+}  // namespace
